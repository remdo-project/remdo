{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "vite": true,
  "vitest": true,
  "playwright": true,
  "ignoreUnresolved": [
    // Shell scripts invoked at runtime via spawnSync/execFileSync from specs, not module imports.
    "./tools/env.sh",
    "./tools/prod/docker.sh"
  ],
  // Test-visible exports that are also used inside their production module are
  // live implementation details, not dead production code.
  "ignoreExportsUsedInFile": true,
  "entry": [
    "tools/snapshot/cli.ts!",
    "src/collaboration-server/main.ts!",
    // Django renders the app page that loads this Vite entry.
    "src/client/app/shell/main.tsx!",
    "playwright.docker.config.ts",
    // Browser tests import this fixture through Vite URLs inside page.evaluate.
    "tests/e2e/_support/local-persistence-browser.ts",
    "tools/{check-pnpm-policy,collab-server,generate-api-client}.ts",
    ".agents/skills/remdo-verify-change/tools/run-reviews.ts",
    // Django's launcher consumes the server configuration projection.
    "tools/dev/**/*.ts",
    "tests/perf/**/*.bench.ts",
    "tests/perf/generate-workload.ts",
    "vitest.bench.perf.config.mts"
  ],
  "project": [
    // `!` marks the production graph used by `knip --production`.
    "src/**/*.{ts,tsx,mts}!",
    "!src/**/*.spec.{ts,tsx,mts}!",
    "config/{index.ts,env/**/*.ts}!",
    "tests/**/*.{ts,tsx,mts}",
    "config/{_internal,eslint,playwright,vite}/**/*.{ts,tsx,mts}",
    "tools/lib/**/*.{ts,tsx,mts}",
    ".agents/skills/**/*.{ts,tsx,mts}",
    "*.{ts,mts}"
  ]
}
