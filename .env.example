# shellcheck disable=SC2034
# RemDo operator settings. Copy this file to .env and set only what you need.
# Internal, derived, and platform-supplied variables are intentionally omitted.

# Shared exposure override. Defaults stay private/local; setting this publishes
# self-hosted production or binds development on every IPv4 interface.
# HOST=0.0.0.0

# Self-hosted production defaults to https://remdo.localhost:8443 on loopback.
# Direct HTTPS access requires its exact public origin and the HOST override:
# APP_ORIGIN=https://remdo.example.com

# Optional existing PostgreSQL service, reachable from the production container.
# Without it, Django uses SQLite under DATA_DIR.
# DATABASE_URL=postgresql://user:password@database.example/remdo

# Production generates and reuses DATA_DIR/secrets.json.

# Development overrides. Repository defaults work without setting these.
# Use the shared HOST override above for a headless development machine.
# Set only when the browser reaches the development machine through a different
# hostname or IP than the machine hostname.
# PUBLIC_HOST=dev-vm.example.test
# Dev port knob: PORT and all secondary dev service ports derive from PORT_BASE.
# PORT_BASE=4000

# Repository tooling (not application runtime configuration). See
# tools/remote/README.md. The backup helper uses the default remote source and
# auto-discovers optional PROD_APP_ADDR_<suffix> targets.
# For Render, copy the SSH command from Dashboard -> Connect -> SSH and use /app.
# make-backup.sh appends /data, so /app maps to /app/data/{backup,collab}.
# Prefer service-level SSH targets (no instance slug); slugs can rotate.
# PROD_APP_ADDR=srv-abc123@ssh.frankfurt.render.com:/app
# PROD_APP_ADDR_staging=srv-def456@ssh.frankfurt.render.com:/app
# PROD_APP_ADDR_vm=deploy@vm.example.com:~/projects/remdo
