{
	admin off
	auto_https disable_redirects
}

{$CADDY_SITE_ADDRESS} {
	bind {$REMDO_GATEWAY_BIND_ADDRESS:0.0.0.0}

	route {
		request_header -X-Remdo-Collaboration-Secret
		request_header -X-Remdo-Collaboration-Operator
		@internal path /internal /internal/*
		handle @internal {
			header Cache-Control "no-store"
			respond 404
		}
		header Cache-Control "no-cache"
		handle /health {
			rewrite * /api/health
			reverse_proxy 127.0.0.1:{env.API_SERVER_PORT} {
				header_up X-Forwarded-Proto {env.CADDY_FORWARDED_PROTO}
				header_down Cache-Control "no-store"
			}
		}

		@app_favicon path /favicon.ico
		handle @app_favicon {
			root * /srv/remdo
			rewrite * /logo.svg
			file_server
		}

		handle_path /django-static/* {
			root * /app/static
			file_server
		}

		@collab path /collaboration
		handle @collab {
			reverse_proxy 127.0.0.1:{env.COLLAB_SERVER_PORT} {
				header_down Cache-Control "no-store"
			}
		}

		@mcp path /mcp
		handle @mcp {
			reverse_proxy 127.0.0.1:{env.MCP_SERVER_PORT} {
				header_down Cache-Control "no-store"
			}
		}

		@app_assets path /app-assets/* /icons/* /logo.svg /icon-192.png /icon-512.png /icon-maskable-512.png /manifest.webmanifest /sw.js /workbox-*.js /registerSW.js
		handle @app_assets {
			root * /srv/remdo
			file_server
		}

		handle {
			reverse_proxy 127.0.0.1:{env.API_SERVER_PORT} {
				header_up X-Forwarded-Proto {env.CADDY_FORWARDED_PROTO}
				header_down Cache-Control "no-store"
			}
		}
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_text}" {err.status_code}
	}
}
