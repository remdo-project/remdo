{
	admin off
	auto_https disable_redirects
}

{$CADDY_SITE_ADDRESS} {
	bind {$REMDO_GATEWAY_BIND_ADDRESS:0.0.0.0}

	route {
		handle /health {
			rewrite * /api/health
			reverse_proxy 127.0.0.1:{env.API_SERVER_PORT}
		}

		@app_favicon path /favicon.ico /favicon.png
		handle @app_favicon {
			root * /srv/remdo
			rewrite * /favicon.png
			file_server
		}

		@options method OPTIONS
		handle @options {
			respond 204
		}

		@api path /api /api/* /.well-known /.well-known/*
		handle @api {
			reverse_proxy 127.0.0.1:{env.API_SERVER_PORT}
		}

		handle_path /share/* {
			root * /data/public-share
			header Cache-Control "no-cache"
			file_server
		}

		@collab path /d /d/*
		handle @collab {
			reverse_proxy 127.0.0.1:{env.COLLAB_SERVER_PORT}
		}

		@app_routes not path /api /api/* /.well-known /.well-known/* /d /d/* /doc*
		handle @app_routes {
			route {
				root * /srv/remdo
				try_files {path} {path}/ /index.html
				file_server
			}
		}

		respond 404
	}
}
