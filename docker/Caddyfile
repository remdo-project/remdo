{
	admin off
	auto_https disable_redirects
}

{$CADDY_SITE_ADDRESS} {
	bind {$REMDO_GATEWAY_BIND_ADDRESS:0.0.0.0}

	route {
		header Cache-Control "no-cache"
		handle /health {
			rewrite * /api/health
			reverse_proxy 127.0.0.1:{env.API_SERVER_PORT} {
				header_up X-Forwarded-Proto {env.CADDY_FORWARDED_PROTO}
				header_down Cache-Control "no-store"
			}
		}

		@app_favicon path /favicon.ico /favicon.png
		handle @app_favicon {
			root * /srv/remdo
			rewrite * /favicon.png
			file_server
		}

		@options method OPTIONS
		handle @options {
			respond 204
		}

		@api path /api /api/* /accounts /accounts/* /admin /admin/* /.well-known /.well-known/*
		handle @api {
			reverse_proxy 127.0.0.1:{env.API_SERVER_PORT} {
				header_up X-Forwarded-Proto {env.CADDY_FORWARDED_PROTO}
				header_down Cache-Control "no-store"
			}
		}

		handle_path /django-static/* {
			root * /app/static
			file_server
		}

		handle_path /share/* {
			root * /data/public-share
			file_server
		}

		@collab path /d /d/*
		handle @collab {
			reverse_proxy 127.0.0.1:{env.COLLAB_SERVER_PORT} {
				header_down Cache-Control "no-store"
			}
		}

		@app_routes path / /n/* /sharing /sharing/ /oauth/consent /oauth/consent/
		handle @app_routes {
			route {
				root * /srv/remdo
				rewrite * /index.html
				file_server
			}
		}

		handle {
			root * /srv/remdo
			file_server
		}
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_text}" {err.status_code}
	}
}
