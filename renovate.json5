{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:weekly",
    ":maintainLockFilesWeekly",
    "security:minimumReleaseAgeNpm",
    "security:minimumReleaseAgePypi",
    ":approveMajorUpdates",
    ":rebaseStalePrs",
  ],
  // Dependabot security updates raise every fix this would, including transitive ones.
  "vulnerabilityAlerts": {
    "enabled": false,
  },
  "timezone": "Europe/Warsaw",
  // A rate limit would hold an update back without a PR to show for it.
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/", "/^docs/guides/mobile-devices\\.md$/"],
      "matchStrings": ["(?<depName>ghcr\\.io/hadolint/hadolint|testingbot/tunnel):(?<currentValue>[\\w.-]+)"],
      "datasourceTemplate": "docker",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pnpm-workspace\\.yaml$/"],
      "matchStrings": ["(?<depName>caniuse-lite): (?<currentValue>\\d[\\w.]*)"],
      "datasourceTemplate": "npm",
    },
  ],
  "packageRules": [
    {
      "description": "An override holds a transitive dependency at its owner's major, so only minors and patches are proposed.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides", "pnpm.overrides", "pnpm-workspace.overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions",
    },
    {
      "description": "0.x minors may break, so they stay out of the non-major group.",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": "pre-1.0 minors",
    },
    {
      "description": "Each stylelint-config-recommended major accepts only the matching stylelint major.",
      "extends": ["packages:stylelint"],
      "matchUpdateTypes": ["major"],
      "groupName": "stylelint",
    },
    {
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "groupName": "uv",
    },
    {
      // TODO(deps): drop with the Lexical patches in pnpm-workspace.yaml; Renovate cannot regenerate them, so a bump needs a manual patch pass.
      // Probe: remove patchedDependencies and this rule, then run the regressions named beside each patch.
      "matchPackageNames": ["lexical", "@lexical/*"],
      "groupName": "lexical",
      "dependencyDashboardApproval": true,
    },
    {
      "description": "A Python minor moves requires-python, .python-version, both Dockerfile stages and CI together.",
      "matchPackageNames": ["python"],
      "groupName": "python",
    },
    {
      // TODO(deps): retry workbox-build once a release past 7.4.0 stops pulling @trickfilm400/rollup-plugin-off-main-thread@3.0.0-pre1, a trust downgrade.
      // Probe: remove this rule, then run a cold pnpm install and the Docker E2E group on the update.
      "matchPackageNames": ["workbox-build"],
      "enabled": false,
    },
    {
      // TODO(deps): retry TypeScript 7 once typescript-eslint accepts it; its peer range stops below 6.1 (typescript-eslint#10940).
      // Probe: remove this rule, then run typecheck and lint:code on the update.
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },
  ],
}
