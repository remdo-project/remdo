{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":maintainLockFilesWeekly"],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 0-8 * * 1"],
  "prConcurrentLimit": 3,
  "lockFileMaintenance": { "schedule": ["* 0-8 * * 1"] },
  "packageRules": [
    {
      "description": "Overrides are dependency repairs, reviewed with their owning update.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides", "pnpm.overrides", "pnpm-workspace.overrides"],
      "enabled": false,
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "groupName": "GitHub Actions",
    },
    {
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "groupName": "uv",
    },
    {
      // TODO(deps): retry TypeScript; typescript-eslint rejects 7.0 and tracks 7.1+ in typescript-eslint#10940.
      // Probe: approve the dashboard update and run typecheck and lint:code against its generated lockfile.
      "matchPackageNames": ["typescript"],
      "dependencyDashboardApproval": true,
    },
    {
      // TODO(deps): retry workbox-build; 7.4.1 pulls @trickfilm400/rollup-plugin-off-main-thread@3.0.0-pre1, a trust downgrade.
      // Probe: approve the dashboard update and run a cold pnpm install and the Docker E2E group.
      "matchPackageNames": ["workbox-build"],
      "dependencyDashboardApproval": true,
    },
  ],
}
